# Frontend environment variables (for local dev and Vercel)
# Copy to .env for local dev, or set these in Vercel → Project Settings → Environment Variables

# Backend API base URL (with /api/v1). Used for auth, prompt injection, etc.
REACT_APP_API_URL=http://localhost:8000/api/v1

# Backend base URL (no path). Used by some pages (model-poisoning, data-poisoning).
REACT_APP_API_BASE_URL=http://localhost:8000

# Google OAuth Client ID (optional, for Sign in with Google)
# REACT_APP_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Supabase Auth: when set, "Continue with Google" uses Supabase OAuth (no backend fallback for Google).
# Required for Google sign-in after redeploy. Set in Vercel → Environment Variables.
# REACT_APP_SUPABASE_URL=https://xxxxx.supabase.co
# REACT_APP_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Optional: production app URL (e.g. https://fyp-llmshield.vercel.app). When set, OAuth redirect after login goes here.
# Use this so you only need one "Authorized JavaScript origin" in Google Console (your production URL).
# REACT_APP_APP_URL=https://fyp-llmshield.vercel.app
